# .env.example - Copy this file to .env and fill in real values.
# DO NOT commit .env to Git!

# CognoDB Cloud
BOLT_COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
BOLT_COGNODB_USER=cognodb
BOLT_COGNODB_PASS=your_cognodb_password

# Neo4j AuraDB
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password

# Local / Containerized Targets
BOLT_MEMGRAPH_URI=bolt://localhost:7687
FALKOR_URI=redis://localhost:6379
ARCADE_URL=http://localhost:2480
